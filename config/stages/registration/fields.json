{
  "comment": "候选人登记阶段字段配置（登记时间在手动新增时自动填写；投递时间在主数据表导入时从应聘档案编号解析）",
  "fields": [
    {
      "key": "registration_source",
      "label": "来源渠道",
      "excel_column": "来源渠道",
      "type": "select",
      "options": ["招聘网站", "校园宣讲", "熟人推荐", "社交平台", "简历拆分", "其他"],
      "visible": true,
      "editable": true,
      "importable": true,
      "required": true
    },
    {
      "key": "registration_source_custom",
      "label": "自定义简历来源",
      "excel_column": "自定义简历来源",
      "type": "text",
      "visible": false,
      "editable": true,
      "importable": false
    },
    {
      "key": "stage_action_status",
      "label": "环节状态",
      "excel_column": "环节状态",
      "type": "select",
      "options": ["待处理", "处理中", "通过", "未通过", "放弃"],
      "colors": {
        "待处理": "gray",
        "处理中": "blue",
        "通过": "green",
        "未通过": "red",
        "放弃": "yellow"
      },
      "visible": false,
      "editable": false,
      "importable": false
    },
    {
      "key": "registration_time",
      "label": "登记时间",
      "excel_column": "登记时间",
      "type": "date",
      "visible": true,
      "editable": false,
      "importable": true
    },
    {
      "key": "delivery_time",
      "label": "投递时间",
      "excel_column": "投递时间",
      "type": "date",
      "visible": true,
      "editable": false,
      "importable": false
    },
    {
      "key": "registration_remark",
      "label": "登记备注",
      "excel_column": "登记备注",
      "type": "text",
      "multiline": true,
      "visible": true,
      "editable": true,
      "importable": true
    }
  ]
}
