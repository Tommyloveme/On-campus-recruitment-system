{
  "comment": "候选人登记阶段字段配置（登记时间在手动新增时自动填写；投递时间在主数据表导入时从应聘档案编号解析）",
  "fields": [
    {
      "key": "registration_source",
      "label": "来源渠道",
      "excel_column": "来源渠道",
      "type": "select",
      "options": ["线上投递", "校园宣讲", "熟人推荐", "社交平台", "其他"],
      "visible": true,
      "editable": true,
      "importable": true,
      "required": true
    },
    {
      "key": "registration_source_custom",
      "label": "自定义简历来源",
      "excel_column": "自定义简历来源",
      "type": "text",
      "visible": false,
      "editable": true,
      "importable": false
    },
    {
      "key": "registration_status",
      "label": "登记状态",
      "excel_column": "登记状态",
      "type": "select",
      "options": ["待投递", "已投递", "已放弃"],
      "colors": { "待投递": "blue", "已投递": "green", "已放弃": "red" },
      "visible": true,
      "editable": true,
      "importable": true
    },
    {
      "key": "registration_time",
      "label": "登记时间",
      "excel_column": "登记时间",
      "type": "date",
      "visible": true,
      "editable": false,
      "importable": true
    },
    {
      "key": "delivery_time",
      "label": "投递时间",
      "excel_column": "投递时间",
      "type": "date",
      "visible": true,
      "editable": false,
      "importable": false
    },
    {
      "key": "registration_remark",
      "label": "登记备注",
      "excel_column": "登记备注",
      "type": "text",
      "multiline": true,
      "visible": true,
      "editable": true,
      "importable": true
    }
  ]
}
