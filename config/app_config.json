{
  "comment": "系统运行配置：易于变更的内容集中在此，修改后重启服务生效（ui 部分刷新页面即生效）",
  "server": {
    "port": 8000,
    "threads": 32,
    "max_upload_mb": 0,
    "channel_timeout_sec": 1800,
    "comment": "max_upload_mb=0 表示不限制上传大小（主数据大表导入）；channel_timeout_sec 为 waitress 请求超时秒数"
  },
  "ui": {
    "page_size": 15,
    "page_size_options": [15, 30, 50, 100, 0],
    "clip_max_width": 320
  },
  "backup": {
    "interval_hours": 1,
    "retention_days": 3
  },
  "master_import": {
    "parse_workers": 2,
    "prepare_workers": 4,
    "write_batch_size": 300,
    "comment": "parse_workers=并行解析 Excel 数；prepare_workers=并行预处理（阶段判定/合并）线程数；write_batch_size=批量提交行数。SQLite 写入仍串行。"
  },
  "logging": {
    "level": "INFO",
    "max_bytes_mb": 10,
    "backup_count": 5,
    "comment": "server.log 超过 max_bytes_mb 后轮转并 gzip 压缩，保留 backup_count 个归档"
  },
  "security": {
    "default_password": "123456",
    "reserved_accounts": ["admin"]
  },
  "permissions": {
    "merge_mode": "union",
    "inherit_user_group": true,
    "inherit_resource_group": true,
    "admin_bypass": true
  },
  "user_profile": {
    "employee_id_digits": 8,
    "dept_level2_options": ["存储部", "计算部", "网络部", "软件部"],
    "dept_level3_options": ["块存储", "对象存储", "通用计算", "研发一组"]
  },
  "resume": {
    "allowed_ext": [".pdf", ".docx"]
  },
  "logs": {
    "page_size": 50
  },
  "interview": {
    "slot_minutes": 45,
    "time_step_minutes": 5,
    "day_start": "08:00",
    "day_end": "20:00",
    "position_options": ["软件岗", "测试岗", "算法岗", "硬件岗", "产品岗"]
  }
}
