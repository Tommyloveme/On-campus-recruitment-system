{
  "comment": "Application*.xlsx：校招主进度表。登记五字段列映射见 field_mappings.json；本文件配置工作表与其它流程字段。",
  "key": "application",
  "label": "Application 主表",
  "description": "文件名须匹配 Application*.xlsx",
  "storage_name": "application.xlsx",
  "sheet_name": "Sheet",
  "sheet_index": 0,
  "columns": [
    { "excel_column": "简历编号", "field_key": "resume_id", "required": true, "match_patterns": ["*简历*编号*"] },
    { "excel_column": "三层部门", "field_key": "dept_level3", "excel_aliases": ["入职三层"], "match_patterns": ["*三层*"] },
    { "excel_column": "二层部门", "field_key": "_group_name", "match_patterns": ["*二层*", "*部门*"] },
    { "excel_column": "拓源人", "field_key": "sourcer" },
    { "excel_column": "拓源人部门", "field_key": "sourcer_dept" },
    { "excel_column": "接口人", "field_key": "interface_person" },
    { "excel_column": "接口人部门", "field_key": "interface_dept" },
    { "excel_column": "来源渠道", "field_key": "registration_source" },
    { "excel_column": "拟录取工作地", "field_key": "work_location", "excel_aliases": ["工作地"], "match_patterns": ["*工作地*"] },
    { "excel_column": "登记状态", "field_key": "registration_status" },
    { "excel_column": "简历筛选状态", "field_key": "resume_screening_status", "match_patterns": ["*筛选*"] },
    { "excel_column": "资审状态", "field_key": "qualification_status" },
    { "excel_column": "笔试状态", "field_key": "written_test_status" },
    { "excel_column": "技术面状态", "field_key": "tech_interview_status" },
    { "excel_column": "主管面状态", "field_key": "manager_interview_status" },
    { "excel_column": "报批状态", "field_key": "approval_status" },
    { "excel_column": "谈薪状态", "field_key": "salary_status" },
    { "excel_column": "Offer状态", "field_key": "offer_status", "match_patterns": ["*Offer*", "*offer*"] },
    { "excel_column": "签约状态", "field_key": "sign_status" },
    { "excel_column": "是否入职", "field_key": "onboarded" }
  ]
}
