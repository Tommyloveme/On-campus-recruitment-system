{
  "comment": "网页字段与 Application*.xlsx 列映射（均来自 Application 表）。lock_on_import 为 true 时导入后不可在界面修改。",
  "fields": [
    {
      "field_key": "resume_id",
      "ui_label": "简历编号",
      "lock_on_import": true,
      "sources": {
        "application": {
          "excel_column": "简历编号",
          "required": true,
          "match_patterns": ["*简历*编号*"]
        }
      }
    },
    {
      "field_key": "name",
      "ui_label": "候选人",
      "lock_on_import": true,
      "sources": {
        "application": {
          "excel_column": "候选人",
          "required": true,
          "match_patterns": ["*候选人*", "*姓名*"]
        }
      }
    },
    {
      "field_key": "phone",
      "ui_label": "电话",
      "lock_on_import": true,
      "sources": {
        "application": {
          "excel_column": "电话",
          "match_patterns": ["*电话*", "*手机*"]
        }
      }
    },
    {
      "field_key": "education",
      "ui_label": "学历",
      "lock_on_import": true,
      "sources": {
        "application": {
          "excel_column": "学历",
          "match_patterns": ["*学历*"]
        }
      }
    },
    {
      "field_key": "school",
      "ui_label": "毕业院校",
      "lock_on_import": true,
      "sources": {
        "application": {
          "excel_column": "毕业院校",
          "match_patterns": ["*毕业*院校*", "*毕业学校*", "*学校*"]
        }
      }
    },
    {
      "field_key": "major",
      "ui_label": "专业",
      "lock_on_import": true,
      "sources": {
        "application": {
          "excel_column": "专业",
          "match_patterns": ["*专业*"]
        }
      }
    }
  ]
}
