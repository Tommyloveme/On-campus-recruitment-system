{
  "comment": "主数据导入字段映射（外部 Excel 列 ↔ 内部字段的隔离层）。sources 配置各 Excel 的文件名模式与工作表；excel_column/excel_aliases 支持精确名与 * 通配；ui_label 为空则网页不可见；lock_on_import 为 true 导入后不可编辑。未配置的 Excel 列按表头原文自动入库（界面默认不可见），外部表头变化只需改本文件。",
  "sources": {
    "application": {
      "file_pattern": "application*.xlsx",
      "sheet_name": "Sheet",
      "sheet_index": 0,
      "label": "Application 主表",
      "description": "校招主进度表（含 applicationProcessList 导出格式）",
      "storage_name": "application.xlsx"
    },
    "interview_mgmt": {
      "file_pattern": "候选人面试安排管理列表*.xlsx",
      "sheet_name": "Sheet1",
      "sheet_index": 0,
      "label": "面试安排管理表",
      "description": "候选人面试安排管理列表（真实业务表，与主表按应聘档案编号关联）",
      "storage_name": "interview_mgmt.xlsx"
    },
    "candidate_mgmt": {
      "file_pattern": "候选人管理*.xlsx",
      "sheet_name": "Sheet",
      "sheet_index": 0,
      "label": "候选人管理表",
      "description": "候选人补充状态表（历史格式，可选）",
      "storage_name": "candidate_mgmt.xlsx"
    }
  },
  "fields": [
