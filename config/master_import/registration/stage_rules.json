{
  "comment": "阶段判定规则：priority 越高越优先。条件字段仅使用两张真实业务表（applicationProcessList / 候选人面试安排管理列表）中实际存在的映射列，核心依据为「当前环节」（应聘表列名为“当前缓解”）。旧格式 fields/values（* 任意非空，支持通配符）；新格式 when 条件树支持 all(与)/any(或)/not(非) 嵌套组合，op 支持 eq/ne/contains/icontains(模糊包含)/regex(正则)/wildcard/in/not_in/empty/not_empty/startswith/endswith/gt/gte/lt/lte，field 可写英文 field_key、Excel 中文列名或界面标签，table 可指定 预处理表/主数据原始表/手动原始表。",
  "rules": [
    { "priority": 110, "stage": "onboarding", "label": "环节-入职", "when": {"any": [
      {"field": "current_step", "op": "icontains", "value": "入职"},
      {"field": "current_step", "op": "icontains", "value": "报到"}
    ]}},
    { "priority": 108, "stage": "contract_signing", "label": "环节-签约", "when": {"field": "current_step", "op": "icontains", "value": "签约"}},
    { "priority": 106, "stage": "offer", "label": "环节-Offer", "when": {"any": [
      {"field": "current_step", "op": "icontains", "value": "Offer"},
      {"field": "current_step", "op": "icontains", "value": "offer"}
    ]}},
    { "priority": 104, "stage": "salary", "label": "环节-谈薪", "when": {"field": "current_step", "op": "icontains", "value": "谈薪"}},
    { "priority": 102, "stage": "approval", "label": "环节-报批", "when": {"field": "current_step", "op": "icontains", "value": "报批"}},
    { "priority": 97, "stage": "manager_interview", "label": "环节-主管面", "when": {"field": "current_step", "op": "icontains", "value": "主管"}},
    { "priority": 92, "stage": "tech_interview", "label": "环节-专业/技术面", "when": {"any": [
      {"field": "current_step", "op": "icontains", "value": "专业面试"},
      {"field": "current_step", "op": "icontains", "value": "技术面"},
      {"field": "current_step", "op": "icontains", "value": "业务主管"}
    ]}},
    { "priority": 91, "stage": "qualification_interview", "label": "环节-资格面试", "when": {"field": "current_step", "op": "icontains", "value": "资格面试"}},
    { "priority": 88, "stage": "personality_test", "label": "环节-性格/综合测评", "when": {"any": [
      {"field": "current_step", "op": "icontains", "value": "性格"},
      {"field": "current_step", "op": "icontains", "value": "测评"}
    ]}},
    { "priority": 86, "stage": "written_test", "label": "环节-笔试", "when": {"any": [
      {"field": "current_step", "op": "icontains", "value": "笔试"},
      {"field": "current_step", "op": "icontains", "value": "考试"}
    ]}},
    { "priority": 85, "stage": "commercial_secret", "label": "环节-商业秘密签署", "when": {"any": [
      {"field": "current_step", "op": "icontains", "value": "商业秘密"},
      {"field": "current_step", "op": "icontains", "value": "保密"},
      {"field": "current_step", "op": "icontains", "value": "签署"}
    ]}},
    { "priority": 84, "stage": "qualification", "label": "环节-资审", "when": {"field": "current_step", "op": "icontains", "value": "资审"}},
    { "priority": 82, "stage": "resume_screening", "label": "环节-简历筛选", "when": {"field": "current_step", "op": "icontains", "value": "简历筛选"}},
    { "priority": 80, "stage": "tech_interview", "label": "环节-面试评价", "when": {"field": "current_step", "op": "icontains", "value": "面试"}},
    { "priority": 40, "stage": "written_test", "label": "笔试进行中", "fields": ["written_test_status", "personality_test_status"], "values": ["已预约", "待测评"] },
    { "priority": 35, "stage": "written_test", "label": "笔试已完成", "fields": ["written_test_status", "personality_test_status"], "values": ["已完成", "待测评"] },
    { "priority": 32, "stage": "commercial_secret", "label": "商业秘密已签署待笔试", "fields": ["commercial_secret_status", "written_test_status"], "values": ["已签署", "待预约"] },
    {
      "priority": 22,
      "stage": "resume_screening",
      "label": "简历筛选中(主数据院校模糊匹配示例)",
      "when": {
        "all": [
          { "field": "毕业院校", "op": "icontains", "value": "大学", "table": "主数据原始表" },
          { "field": "当前环节", "op": "icontains", "value": "筛选" }
        ]
      }
    }
  ]
}
