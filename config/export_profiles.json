        { "key": "delivery_time", "label": "投递时间" },
        { "source": "hub", "hub_source": "master_import", "field": "当前环节", "label": "主数据-当前环节" },
        { "source": "hub", "hub_source": "master_import", "field": "当前环节状态", "label": "主数据-当前环节状态" },
        { "source": "hub", "hub_source": "master_import", "field": "应聘状态", "label": "主数据-应聘状态" },
        { "source": "computed", "key": "latest_log", "label": "最新进展" }
